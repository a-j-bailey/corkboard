# Copy to .env and fill in local values. Never commit real keys.

# Supabase (required for auth, events, and storage)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# xAI vision extraction (required for poster scanning)
EXPO_PUBLIC_XAI_API_KEY=your-xai-api-key
# Optional; defaults to https://api.x.ai/v1
EXPO_PUBLIC_XAI_BASE_URL=https://api.x.ai/v1

# Optional: Vexo analytics (used in production builds only)
EXPO_PUBLIC_VEXO_API_KEY=

# Optional: run local OCR before the vision model
# EXPO_PUBLIC_OCR_FIRST_EXTRACTION=1

# Deprecated fallback for vision extraction; prefer EXPO_PUBLIC_XAI_API_KEY
# EXPO_PUBLIC_OPENAI_API_KEY=
